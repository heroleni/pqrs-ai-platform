# ==========================================================================
#  Plataforma SaaS de PQRS — variables de entorno
#  Copia este archivo como .env y llena los valores.
#  El .env NO se versiona.
# ==========================================================================

# --- Base de datos -------------------------------------------------------
POSTGRES_USER=pqrs
POSTGRES_PASSWORD=
POSTGRES_DB=pqrsdb

# Puerto que expone Postgres en la máquina anfitriona.
# El 5432 suele estar ocupado por otro Postgres del equipo.
POSTGRES_HOST_PORT=5433

# Solo la usa la API cuando corre fuera de Docker (desde el IDE).
# Dentro de docker-compose el host es "db", no "localhost": cada contenedor
# tiene su propia red. El compose la inyecta ya corregida.
CONNECTION_STRING=Host=localhost;Port=5433;Database=pqrsdb;Username=pqrs;Password=CAMBIAME

# --- Autenticación JWT ---------------------------------------------------
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=pqrs-platform
JWT_AUDIENCE=pqrs-platform
JWT_EXPIRATION_MINUTES=480

# --- Proveedor de IA -----------------------------------------------------
# Valores: OpenAi | Gemini | Local
# Si se deja vacío, se elige automáticamente:
#   1. Hay OPENAI_API_KEY  -> OpenAi
#   2. Hay GEMINI_API_KEY  -> Gemini
#   3. No hay ninguna      -> Local (sin internet, por reglas)
AI_PROVIDER=

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_LLM_MODEL=gemini-2.0-flash

# Similitud coseno mínima para responder desde la base de conocimiento.
# Por debajo de este valor no se llama al LLM y el widget abre el formulario.
# Calibrado por proveedor:
#   OpenAi 0.75  |  Gemini 0.70  |  Local 0.35
RAG_SIMILARITY_THRESHOLD=0.75

# Cuántos artículos se envían al LLM como contexto.
RAG_TOP_K=3

# --- API -----------------------------------------------------------------
# El 8080 suele estar ocupado en los equipos de la sede.
API_HOST_PORT=8081
ASPNETCORE_ENVIRONMENT=Development
